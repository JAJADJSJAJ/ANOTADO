# Copiá a evals/.env (ignorado por git). Cualquier API compatible con OpenAI.
IA_BASE_URL=https://openrouter.ai/api/v1
IA_API_KEY=
# Elegido por evals (ver docs/decisiones.md § Fase 2): 25/26, ~2 s por mensaje.
IA_MODELO=deepseek/deepseek-v4-flash
# json_object: en modo json_schema estricto DeepSeek empeora mucho (0/3 en casos simples)
IA_FORMATO=json_object
# Campos extra para OpenRouter: sin razonamiento (rápido) y solo proveedores occidentales
# que no guardan ni entrenan con los datos (Ley 18.331).
IA_EXTRA={"reasoning":{"enabled":false},"provider":{"order":["DeepInfra","Azure","DigitalOcean"],"allow_fallbacks":false,"data_collection":"deny"}}
# Opcional, para estimar costo: US$ por millón de tokens
IA_PRECIO_ENTRADA=0.09
IA_PRECIO_SALIDA=0.18
