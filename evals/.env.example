# Copiá a evals/.env (ignorado por git). Cualquier API compatible con OpenAI.
IA_BASE_URL=https://openrouter.ai/api/v1
IA_API_KEY=
IA_MODELO=deepseek/deepseek-v4.1-flash
# json_schema (preferido) o json_object si el proveedor no soporta json_schema
IA_FORMATO=json_schema
# Opcional, para estimar costo: US$ por millón de tokens
IA_PRECIO_ENTRADA=
IA_PRECIO_SALIDA=
