# Copiá a supabase/functions/.env (ignorado por git). Lo lee `pnpm supabase functions serve`.
# En la nube se cargan con `pnpm supabase secrets set`. Misma config que evals/.env.example.
IA_BASE_URL=https://openrouter.ai/api/v1
IA_API_KEY=
IA_MODELO=deepseek/deepseek-v4-flash
IA_FORMATO=json_object
IA_EXTRA={"reasoning":{"enabled":false},"provider":{"order":["DeepInfra","Azure","DigitalOcean"],"allow_fallbacks":false,"data_collection":"deny"}}
